<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Lets the app ask for battery-optimisation exemption with a single system dialog instead
        of dumping the user in the list of every installed app. Play restricts this permission to
        apps whose core function needs it; "alarms or reminders" is one of the listed cases.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Alarm-style reminders: ring over the lock screen and keep ringing until answered. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReminderApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReminderApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Its own task, so dismissing an alarm never reveals the app underneath. -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=".alarm"
            android:theme="@style/Theme.ReminderApp"
            android:turnScreenOn="true" />

        <service
            android:name=".service.AlarmService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Reads spoken reminders aloud: Android 17 mutes audio started from the background,
             so the few seconds of speech run as a foreground service. -->
        <service
            android:name=".service.AlertSoundService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <!-- Direct-boot aware: data lives in device storage, so alarms work before unlocking. -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false" />

        <!-- Must be exported to receive the system boot broadcast. -->
        <receiver
            android:name=".service.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Schedule windows are local-time based, so a clock or timezone
                     change invalidates every pending alarm. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- Exact alarms allowed again: upgrade the inexact fallbacks. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
