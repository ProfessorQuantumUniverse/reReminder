<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window/launch theme only. Everything inside the app is drawn by Compose,
        which owns the actual Material 3 colour scheme (see ui/theme/Theme.kt).
    -->
    <style name="Base.Theme.reReminder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ReminderApp" parent="Base.Theme.reReminder" />
</resources>
